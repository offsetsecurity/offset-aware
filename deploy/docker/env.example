# Settings for Offset Aware on Docker.
# Copy this file to .env, in the same folder as compose.yaml, and fill it in.
# Never share .env: it holds the key that protects every sign-in.

# A long random secret. The portal will not start without one. Make one with:
#   docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# The address employees use, put in the emails that send them their sign-in.
PORTAL_URL=https://localhost:3000

# The port people open in the browser. Inside the container it is always 3000.
PORTAL_PORT=3000

# Leave empty to let other computers on the network reach the portal.
# Set to 127.0.0.1 to allow this machine only.
PORTAL_BIND=

# Which image to run. The published one, newest first. Name a version
# instead - :1.0.3 - to hold this machine on one, or point it at an image you
# built here from the source.
#
# The updater writes this line when an administrator installs an update, so it
# always says what is actually running.
PORTAL_IMAGE=ghcr.io/offsetsecurity/offset-aware:latest

# Lets an administrator install updates from inside the portal.
#
# It starts a second, small container - the updater - because a container
# cannot replace itself: the portal would be swapping the image it is running
# inside. The updater pulls the new version, restarts the portal, and puts the
# old version back if the new one does not answer.
#
# Delete this line if your policy does not allow a container access to the
# Docker socket. Everything else still works; updating is then a pull and a
# restart by hand.
COMPOSE_PROFILES=updates

# Where this folder is on the host machine. The updater runs compose from
# inside a container, and the paths it hands Docker are resolved on the host,
# so "." would be wrong. Set it if the portal is not started from this folder.
PORTAL_INSTALL_DIR=.
