# Copy this file to .env and fill in real values. Do NOT commit .env.

# Set to "production" when hosting publicly behind HTTPS.
NODE_ENV=development

PORT=3000

# Public base URL of the portal (used in employee credential emails).
PORTAL_URL=http://localhost:3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Persistent storage paths. On a host, point these at a mounted volume,
# e.g. DB_PATH=/data/database.sqlite and UPLOADS_DIR=/data/uploads
DB_PATH=./database.sqlite
UPLOADS_DIR=./uploads
